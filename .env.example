#Esto sirve para configurar facilmente las variables del entorno para el config.py y otros

# Configuración de Flask
FLASK_APP=src/main.py
FLASK_ENV=development
FLASK_DEBUG=1

# Configuración de la Base de Datos (PostgreSQL o lo que se acabe usando)
DATABASE_URL=postgresql://<usuario>:<contraseña>@localhost:5432/<nombre_bd>

# Seguridad (JWT)
JWT_SECRET_KEY=escribe_aqui_una_clave_aleatoria