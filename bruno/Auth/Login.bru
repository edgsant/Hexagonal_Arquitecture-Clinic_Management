meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/login
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "identificador": "cgarcia",
    "password": "password123"
  }
}

script:post-response {
  if (res.body.access_token) {
    bru.setEnvVar("jwt_token", res.body.access_token);
    console.log("Login successful, JWT token obtained.");
  } else {
    console.log("Login failed, no access token received.");
  }
}