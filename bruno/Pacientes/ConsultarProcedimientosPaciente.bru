meta {
  name: Consultar Procedimientos de un paciente
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/pacientes/pac1/procedimientos
}

headers {
  Authorization: Bearer {{jwt_token}}
}

tests {
  test("El código de estado debe ser 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("La respuesta debe ser una lista (Array) de procedimientos", function() {
    const data = res.getBody();
    expect(data).to.be.an('array');
    expect(data.length).to.be.greaterThan(0); // Sabemos que pac1 tiene el proc1
  });
}