meta {
  name: Consultar Procedimiento
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/procedimientos/proc1
}

headers {
  Authorization: Bearer {{jwt_token}}
}

tests {
  test("El código de estado debe ser 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Debe devolver el procedimiento solicitado", function() {
    const data = res.getBody();
    expect(data).to.be.an('object');
    // Si vuestro DTO devuelve "id" o "id_procedimiento", ajusta esto:
    expect(data.id_procedimiento || data.id).to.equal("proc1");
  });
}