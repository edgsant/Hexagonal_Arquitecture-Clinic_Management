meta {
  name: Crear Procedimiento
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/procedimientos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwt_token}}
}

body:json {
  {
    "id_paciente": "{{id_paciente_nuevo}}"
  }
}

script:post-response {
  // Verificamos que la petición haya sido un éxito antes de intentar sacar datos
  if (res.status === 201 || res.status === 200) {
    // Guardamos el ID en una variable dinámica llamada "id_procedimiento_nuevo"
    bru.setEnvVar("id_procedimiento_nuevo", res.body.id_procedimiento);
    console.log("ID del nuevo procedimiento automatizado: " + res.body.id_procedimiento);
  }
}

tests {
  test("El código de estado debe ser 201 Created (o 200 OK)", function() {
    expect(res.getStatus() === 201 || res.getStatus() === 200).to.be.true;
  });

  test("La respuesta debe ser un JSON válido que contenga el ID del procedimiento", function() {
    const datos = res.getBody();
    expect(datos).to.be.an('object');
    expect(datos).to.have.property('id_procedimiento');
  });
}