meta {
  name: Crear Procedimiento
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/procedimientos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwt_token}}
}

body:json {
  {
    "id_paciente": "pac2" 
  }
}

tests {
  test("El código de estado debe ser 201 Created (o 200 OK)", function() {
    expect(res.getStatus() === 201 || res.getStatus() === 200).to.be.true;
  });

  test("La respuesta debe ser un JSON válido que contenga el ID del procedimiento", function() {
    const datos = res.getBody();
    expect(datos).to.be.an('object');
    expect(datos).to.have.property('id');
  });
}